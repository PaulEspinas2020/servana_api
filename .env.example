# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SECRET=
TEMP_ID=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=
DB_HOST=
DB_DATABASE=
DB_PASSWORD=
DB_PORT=5432
SCHEMA=public

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=
MONGO_HOST=
MONGO_USER=
MONGO_PW=
MONGO_DB=
MONGO_APP_NAME=

# ── Firebase ──────────────────────────────────────────────────────────────────
API_KEY=
AUTH_DOMAIN=
PROJECT_ID=
STORAGE_BUCKET=
SENDER_ID=
APP_ID=
MEASUREMENT_ID=

# ── SendGrid ──────────────────────────────────────────────────────────────────
MAILER_KEY=
MAILER_SENDER=

# ── Semaphore (SMS OTP — Philippines) ────────────────────────────────────────
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SERVANA

# ── Google Places (address autocomplete — Provider Web only) ──────────────────
# Server-side API key — NEVER exposed to the browser.
# Required for: GET /api/location/address-suggestions
#               GET /api/location/address-details/:placeId
# Google Cloud Console setup:
#   1. Enable "Places API" on the project
#   2. Enable "Maps JavaScript API" (needed for Place Details)
#   3. Restrict key to "IP addresses" → add the Linode server IP
#   4. Add this key to the production env file and restart the process
GOOGLE_PLACES_SERVER_API_KEY=

# ── Firebase email action return URLs ─────────────────────────────────────────
# Where a password-reset or email-verification link sends the person AFTER
# Firebase has done its part. Optional: every one of these has a default in
# src/constants/platformContinueUrls.ts, and a caller that does not name a
# platform gets no return URL at all and lands on Firebase's own hosted page —
# which is what the customer mobile app and the admin portal do today.
#
# The caller sends a platform NAME ('provider' | 'customer'), never a URL. A
# reset link that could be pointed at an arbitrary address is a phishing
# primitive wearing Firebase's domain, so the server decides the destination.
#
# NOTE: with Firebase's default action handler the person completes the action
# on Firebase's page and these become the "Continue" link back. That is the
# intended, correct end state — do NOT "fix" it by repointing the console's
# action URL: there is ONE action URL per project and two portals that want it,
# so setting it for one silently changes where the other's links land. That is a
# cross-platform break from a per-platform fix. See
# docs/FIREBASE_EMAIL_ACTION_URLS.md.
#
# Validated at BOOT. An absolute https URL, or the process refuses to start and
# names the variable. A typo here is only ever discovered by the person it locks
# out, so it is not left to run-time.
#
# Defaults (used when unset) live in src/constants/platformContinueUrls.ts:
#   PROVIDER_RESET_URL   https://provider.servana.com.ph/provider/reset-password
#   CUSTOMER_RESET_URL   https://servana.com.ph/reset-password
#   CUSTOMER_VERIFY_URL  https://servana.com.ph/verify-email
#   PROVIDER_VERIFY_URL  (none — the provider portal has no verify-email route,
#                        so an unset value correctly means "stay on Firebase")
PROVIDER_RESET_URL=
PROVIDER_VERIFY_URL=
CUSTOMER_RESET_URL=
CUSTOMER_VERIFY_URL=

# ── Admin portal ──────────────────────────────────────────────────────────────
# Where an admin invite's set-password link returns to. Same family as the four
# above, but NOT on the continue-URL allowlist: admin invites are issued by
# another admin rather than requested by the person, so no client names this
# platform and there is nothing for an attacker to supply.
# Defaults to https://admin.servana.com.ph (src/services/adminInviteService.ts).
ADMIN_PORTAL_URL=
