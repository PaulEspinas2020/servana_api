# Servana API — ignore rules
#
# NOTE: an unresolved merge conflict lived in this file from 1ac5af7 until
# 2026-08-01 — a bare "=======" on line 2 and ">>>>>>> 9e7ec25" on line 155,
# with an empty "ours" side, so a merge silently replaced the whole file.
# The markers were inert as patterns (they only matched files literally named
# "=======") so the rules still worked, but a .gitignore nobody can read is a
# poor place to keep the only line of defence against committing a key.
#
# .gitignore does NOT untrack a file git already knows about. Three separate
# credentials in this codebase were listed here and committed anyway. If you
# add a rule for something already tracked, run `git rm --cached` as well.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# Firebase service account credentials — never commit private keys
# Firebase Admin SDK credentials — a LIVE key that bypasses every Security Rule
# and can mint auth tokens for any UID. Never commit it.
#
# NOTE: these entries were inert until 2026-08-01. .gitignore does not untrack a
# file git already knows about, so the key stayed committed from "first commit"
# onward despite being listed here. It is now untracked — see
# docs/ROTATE_SERVICE_ACCOUNT.md, and rotate, because untracking does not
# un-leak what is already in history.
servana-serviceAccountKey.json
*serviceAccountKey.json
!servana-serviceAccountKey.json.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Test scratch area — see tests/support/tempWorkspace.ts
.test-tmp/
