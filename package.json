{
  "name": "servana_api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp servana-serviceAccountKey.json ./dist",
    "start": "tsc -p . && node dist/app.js",
    "dev": "nodemon --files src/app.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "jest",
    "test:ci": "jest --runInBand --ci",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run guard:protected-contracts && npm run api:docs:check && npm run booking:docs:check && npm run test:ci",
    "verify:quick": "npm run typecheck && npm run typecheck:tests",
    "guard:protected-contracts": "node scripts/guard-protected-contracts.mjs",
    "catalog:integrity": "ts-node -r dotenv/config scripts/catalog-integrity-report.ts",
    "api:docs": "ts-node scripts/generate-api-docs.ts",
    "api:docs:check": "ts-node scripts/generate-api-docs.ts --check",
    "booking:docs": "ts-node scripts/generate-booking-docs.ts",
    "booking:docs:check": "ts-node scripts/generate-booking-docs.ts --check",
    "_comment:ops": "Operational scripts. -r dotenv/config is REQUIRED, not decoration: src/config.ts loads '../.env', which resolves correctly for dist/app.js but points one directory above the app for anything run from the repo root \u2014 so DB_PASSWORD is undefined and pg fails with 'SASL: client password must be a string'. Preloading dotenv reads ./.env from the CWD instead.",
    "audit:identifiers": "ts-node -r dotenv/config scripts/audit-identifier-conflicts.ts",
    "backfill:identifiers": "ts-node -r dotenv/config scripts/backfill-normalized-identifiers.ts",
    "backfill:documents": "ts-node -r dotenv/config scripts/backfill-document-private-storage.ts",
    "admin:bootstrap": "ts-node -r dotenv/config scripts/create-admin-with-password.ts",
    "report:provider-readiness": "ts-node -r dotenv/config scripts/report-provider-readiness.ts",
    "backfill:verified-identifiers": "ts-node -r dotenv/config scripts/backfill-verified-identifiers.ts",
    "migrations:plan": "ts-node -r dotenv/config scripts/run-migrations.ts",
    "migrations:apply": "ts-node -r dotenv/config scripts/run-migrations.ts --apply",
    "migrate:legacy-provider-documents:plan": "ts-node -r dotenv/config scripts/migrate-legacy-provider-documents.ts",
    "migrate:legacy-provider-documents:apply": "ts-node -r dotenv/config scripts/migrate-legacy-provider-documents.ts --apply",
    "measure:reviews": "node scripts/measure-review-api.mjs",
    "check:db-ownership": "ts-node -r dotenv/config scripts/check-db-ownership.ts"
  },
  "keywords": [],
  "author": "Cla H.",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "formidable": "^3.5.4",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.17.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/socket.io": "^3.0.2",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "socket.io-parser": ">=4.2.7"
  }
}
