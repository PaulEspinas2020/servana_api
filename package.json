{
  "name": "servana_api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc -p . && node dist/app.js",
    "dev": "nodemon --files src/app.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "jest",
    "_comment:test:ci": "--logHeapUsage plus scripts/jest-heap-guard.js is the permanent heap guard (TAB 01). --runInBand keeps all 276 suites in ONE V8 heap, which is how a single retaining module aborted the deploy runner with exit 134 and stalled production for six days. The guard fails the run at 70% of the configured limit, so the next 100 MB of growth is a red test run rather than a silent deploy stall.",
    "test:ci": "jest --runInBand --ci --logHeapUsage --reporters=default --reporters=./scripts/jest-heap-guard.js",
    "verify": "npm run typecheck && npm run security:secrets && npm run typecheck:tests && npm run guard:protected-contracts && npm run api:docs:check && npm run booking:docs:check && npm run finance:docs:check && npm run messaging:docs:check && npm run notification:docs:check && npm run account:docs:check && npm run home:docs:check && npm run review:docs:check && npm run clients:reconcile:check && npm run convergence:docs:check && npm run safety:docs:check && npm run test:ci",
    "verify:quick": "npm run typecheck && npm run typecheck:tests",
    "clients:reconcile": "ts-node scripts/reconcile-client-manifests.ts",
    "clients:reconcile:check": "ts-node scripts/reconcile-client-manifests.ts --check",
    "guard:protected-contracts": "node scripts/guard-protected-contracts.mjs",
    "catalog:integrity": "ts-node -r dotenv/config scripts/catalog-integrity-report.ts",
    "api:docs": "ts-node scripts/generate-api-docs.ts",
    "api:docs:check": "ts-node scripts/generate-api-docs.ts --check",
    "booking:docs": "ts-node scripts/generate-booking-docs.ts",
    "booking:docs:check": "ts-node scripts/generate-booking-docs.ts --check",
    "_comment:ops": "Operational scripts. -r dotenv/config is REQUIRED, not decoration: src/config.ts loads '../.env', which resolves correctly for dist/app.js but points one directory above the app for anything run from the repo root \u2014 so DB_PASSWORD is undefined and pg fails with 'SASL: client password must be a string'. Preloading dotenv reads ./.env from the CWD instead.",
    "audit:identifiers": "ts-node -r dotenv/config scripts/audit-identifier-conflicts.ts",
    "backfill:identifiers": "ts-node -r dotenv/config scripts/backfill-normalized-identifiers.ts",
    "backfill:documents": "ts-node -r dotenv/config scripts/backfill-document-private-storage.ts",
    "admin:bootstrap": "ts-node -r dotenv/config scripts/create-admin-with-password.ts",
    "report:provider-readiness": "ts-node -r dotenv/config scripts/report-provider-readiness.ts",
    "backfill:verified-identifiers": "ts-node -r dotenv/config scripts/backfill-verified-identifiers.ts",
    "migrations:plan": "ts-node -r dotenv/config scripts/run-migrations.ts",
    "migrations:apply": "ts-node -r dotenv/config scripts/run-migrations.ts --apply",
    "migrations:ledger:repair": "ts-node scripts/repair-migration-ledger.ts",
    "migrate:legacy-provider-documents:plan": "ts-node -r dotenv/config scripts/migrate-legacy-provider-documents.ts",
    "migrate:legacy-provider-documents:apply": "ts-node -r dotenv/config scripts/migrate-legacy-provider-documents.ts --apply",
    "measure:reviews": "node scripts/measure-review-api.mjs",
    "check:db-ownership": "ts-node -r dotenv/config scripts/check-db-ownership.ts",
    "capability:parity": "ts-node -r dotenv/config scripts/capability-parity-report.ts",
    "capability:reconcile": "ts-node -r dotenv/config scripts/capability-parity-report.ts --apply",
    "finance:docs": "ts-node scripts/generate-finance-docs.ts",
    "finance:docs:check": "ts-node scripts/generate-finance-docs.ts --check",
    "messaging:docs": "ts-node scripts/generate-messaging-docs.ts",
    "messaging:docs:check": "ts-node scripts/generate-messaging-docs.ts --check",
    "notification:docs": "ts-node scripts/generate-notification-docs.ts",
    "notification:docs:check": "ts-node scripts/generate-notification-docs.ts --check",
    "account:docs": "ts-node scripts/generate-account-docs.ts",
    "account:docs:check": "ts-node scripts/generate-account-docs.ts --check",
    "home:docs": "ts-node scripts/generate-home-docs.ts",
    "home:docs:check": "ts-node scripts/generate-home-docs.ts --check",
    "review:docs": "ts-node scripts/generate-review-docs.ts",
    "review:docs:check": "ts-node scripts/generate-review-docs.ts --check",
    "convergence:docs": "ts-node scripts/generate-convergence-docs.ts",
    "convergence:docs:check": "ts-node scripts/generate-convergence-docs.ts --check",
    "safety:docs": "ts-node scripts/generate-release-safety-docs.ts",
    "safety:docs:check": "ts-node scripts/generate-release-safety-docs.ts --check",
    "smoke:plan": "ts-node scripts/production-smoke.ts --plan",
    "smoke": "ts-node scripts/production-smoke.ts",
    "release:summary": "ts-node scripts/release-summary.ts",
    "ddl:inventory": "ts-node scripts/runtime-ddl-inventory.ts",
    "schema:authority": "ts-node scripts/schema-authority.ts",
    "authz:legacy": "ts-node scripts/legacy-authz-inventory.ts",
    "db:verify": "ts-node scripts/verify-fresh-db.ts",
    "db:verify:embedded": "ts-node scripts/verify-fresh-db.ts --embedded",
    "migrations:baseline:plan": "ts-node scripts/verify-baseline-ledger.ts",
    "baseline:plan": "ts-node scripts/capture-schema-baseline.ts --plan",
    "baseline:capture": "ts-node -r dotenv/config scripts/capture-schema-baseline.ts",
    "security:secrets": "ts-node scripts/scan-secrets.ts",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "v1:mounted": "ts-node scripts/verify-v1-mounted.ts",
    "db:skew": "ts-node scripts/verify-schema-code-skew.ts"
  },
  "keywords": [],
  "author": "Cla H.",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "formidable": "^3.5.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.17.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/socket.io": "^3.0.2",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "socket.io-parser": ">=4.2.7",
    "uuid": "^11.1.1"
  }
}
