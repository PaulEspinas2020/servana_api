#!/bin/sh
# Pre-push gate. Enable once per clone with:
#
#     git config core.hooksPath scripts/hooks
#
# ## Why this exists
#
# This repository has NO CI. There are no workflow files at all: Actions credit
# is exhausted and is not being topped up, so every workflow was deleted rather
# than left manual-only. This hook is the ONLY gate that exists.
#
# Deployment is now a direct push plus `scripts/deploy-prod.sh`, run by hand on
# the production host. Note the change carefully: a push to main no longer
# deploys by itself, but it is still the thing production is deployed FROM, and
# the deploy script does not re-run the suite (it runs on a 961 MB box that
# cannot hold it). So this remains the last point at which a broken main can be
# stopped, and a gate that runs after the deploy would not be a gate.
#
# So the check that CI used to perform now runs here, before the push leaves.
#
# Pushing main runs the full `npm run verify`. Anything else runs verify:quick,
# because no other branch deploys and a two-minute wait would just train someone
# to reach for --no-verify.
#
# That caveat is now OUT OF DATE, and the correction matters because this hook is
# currently the only gate.
#
# It used to read: `npm run verify` here passes with credentials present, and 4
# suites fail without them, so do not read a green hook as proof those suites
# pass clean. That was true, and the cause was `middleware/firebaseApp.ts`
# resolving the Firebase Admin credential at MODULE LOAD — so importing the
# composed app required a live production key, and any checkout without one
# failed app-import-is-inert, authz-matrix-behaviour, health-probe-parity and
# v1-composed-app.
#
# fca1ed1 made that resolution lazy. Verified 2026-08-19 with no
# servana-serviceAccountKey.json on disk and FIREBASE_SERVICE_ACCOUNT_JSON
# unset: all four suites pass, 32 tests.
#
# So a green hook now IS proof, and that is the whole point — with no CI at all,
# a gate nobody trusts is a gate people reach past with --no-verify.

set -e

remote_ref_is_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/main) remote_ref_is_main=1 ;;
  esac
done

# stdin is redirected from /dev/null for the verify runs below, and that is
# load-bearing, not tidiness. git hands a pre-push hook the ref list on stdin;
# a child process inherits that pipe and can block on it forever. Without this
# the hook hung for 7.8 hours on its first real push, producing no output and
# leaving the push silently unlanded. Draining the list is fine (proved with a
# trivial hook); it is handing the open pipe to npm that deadlocks.
if [ "$remote_ref_is_main" -eq 1 ]; then
  echo "pre-push: pushing main, which DEPLOYS TO PRODUCTION — running full npm run verify"
  npm run verify < /dev/null
  echo "pre-push: verify passed; allowing the push (and the deploy it triggers)"
else
  echo "pre-push: non-deploying branch — running npm run verify:quick"
  npm run verify:quick < /dev/null
  echo "pre-push: verify:quick passed"
fi
