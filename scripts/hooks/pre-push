#!/bin/sh
# Pre-push gate. Enable once per clone with:
#
#     git config core.hooksPath scripts/hooks
#
# ## Why this exists
#
# release-gate.yml and fresh-db.yml are manual-only: they are GitHub-hosted and
# this repo's Actions credit is exhausted and not being topped up. Without them,
# nothing stood between a push and production — and for this repo a push to main
# IS a production deploy (deploy.yml runs on the self-hosted runner, migrates the
# database, and restarts PM2). A gate that runs after the deploy is not a gate.
#
# So the check that CI used to perform now runs here, before the push leaves.
#
# Pushing main runs the full `npm run verify`. Anything else runs verify:quick,
# because no other branch deploys and a two-minute wait would just train someone
# to reach for --no-verify.
#
# This cannot check what only a GitHub-hosted runner could: `npm run verify` here
# passes with credentials present, and 4 suites fail without them. That gap is
# tests/app-import-is-inert.test.ts and it is a real property of the app, not a
# CI artefact. Do not read a green hook as proof those 4 suites pass clean.

set -e

remote_ref_is_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/main) remote_ref_is_main=1 ;;
  esac
done

# stdin is redirected from /dev/null for the verify runs below, and that is
# load-bearing, not tidiness. git hands a pre-push hook the ref list on stdin;
# a child process inherits that pipe and can block on it forever. Without this
# the hook hung for 7.8 hours on its first real push, producing no output and
# leaving the push silently unlanded. Draining the list is fine (proved with a
# trivial hook); it is handing the open pipe to npm that deadlocks.
if [ "$remote_ref_is_main" -eq 1 ]; then
  echo "pre-push: pushing main, which DEPLOYS TO PRODUCTION — running full npm run verify"
  npm run verify < /dev/null
  echo "pre-push: verify passed; allowing the push (and the deploy it triggers)"
else
  echo "pre-push: non-deploying branch — running npm run verify:quick"
  npm run verify:quick < /dev/null
  echo "pre-push: verify:quick passed"
fi
